<%# "Pin to deck" for one passage. Locals: quote (plain text), document_id, chunk_id. %>
<button class="ghost small" type="button" data-action="pin-dialog#open"
        data-pin-dialog-quote-param="<%= quote %>"
        data-pin-dialog-document-id-param="<%= document_id %>"
        data-pin-dialog-chunk-id-param="<%= chunk_id %>">Pin to deck</button>
