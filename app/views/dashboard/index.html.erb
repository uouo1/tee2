<% content_for :title, "Dashboard" %>
<% counts = @overview[:counts] %>
<% mean = @overview.dig(:sentiment, :mean) %>
<section class="view" id="view-dashboard">
  <div class="view-head">
    <h1>Dashboard</h1>
    <p class="muted" id="dashboard-sub">
      <%= num(counts[:documents]) %> documents across <%= num(counts[:companies]) %> companies,
      <%= num(counts[:chunks]) %> indexed passages and <%= num(counts[:kpis]) %> extracted metrics
      · as of <%= iso(@overview[:as_of]) %>.
    </p>
  </div>

  <div class="tiles" id="dashboard-tiles">
    <% [
         ["Documents", num(counts[:documents]), "#{@overview[:by_type].size} document types"],
         ["Companies covered", num(counts[:companies]), "#{num(counts[:transactions])} precedent deals"],
         ["Extracted metrics", num(counts[:kpis]), "KPIs parsed from narrative text"],
         # No documents means no tone: n/a, not a neutral +0.00.
         ["Mean tone", tone(mean), "#{@positive} positive / #{@negative} negative"],
         ["Pitch books", num(counts[:pitchbooks]), "decks built from this corpus"]
       ].each do |label, value, delta| %>
      <div class="tile">
        <div class="label"><%= label %></div>
        <div class="value"><%= value %></div>
        <div class="delta"><%= delta %></div>
      </div>
    <% end %>
  </div>

  <%# Charts are Charts SVG strings: every label is escaped by Charts. %>
  <div class="panel-grid">
    <div class="panel"><div id="dashboard-sentiment" class="chart-slot"><%= @sentiment_svg.html_safe %></div></div>
    <div class="panel"><div id="dashboard-volume" class="chart-slot"><%= @volume_svg.html_safe %></div></div>
  </div>

  <div class="panel-grid">
    <div class="panel">
      <h2>Emerging themes</h2>
      <p class="muted small">Over-represented in the last 180 days versus the preceding period. Click a theme to search it.</p>
      <div id="dashboard-themes" class="examples">
        <% if @overview[:trending].present? %>
          <% @overview[:trending].each do |theme| %>
            <%= link_to "#{theme[:theme]} · #{theme[:lift]}x", research_path(q: %("#{theme[:theme]}")),
                        class: "chip",
                        title: "#{theme[:mentions]} documents recently vs #{theme[:prior_mentions]} before (#{theme[:lift]}x)" %>
          <% end %>
        <% else %>
          <p class="empty">No emerging themes yet.</p>
        <% end %>
      </div>
    </div>
    <div class="panel">
      <h2>Coverage by company</h2>
      <div id="dashboard-coverage" class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Ticker</th><th scope="col">Company</th>
              <th scope="col" class="num">Docs</th><th scope="col" class="num">Tone</th><th scope="col">Latest</th>
            </tr>
          </thead>
          <tbody>
            <% @overview[:coverage].each do |row| %>
              <tr>
                <td><%= link_to row[:ticker], company_path(row[:ticker]) %></td>
                <td><%= row[:name] %></td>
                <td class="num"><%= num(row[:documents]) %></td>
                <td class="num"><%= tone(row[:sentiment]) %></td>
                <td><%= iso(row[:latest]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>Newest documents</h2>
    <div id="dashboard-recent">
      <% if @overview[:recent].empty? %>
        <p class="empty">No documents yet. Run <code>bin/rails argos:seed</code> or ingest a folder.</p>
      <% end %>
      <% @overview[:recent].each do |row| %>
        <%= render "shared/document_card", title: row[:title], href: document_path(row[:id]), ticker: row[:ticker],
                                           doc_type: row[:doc_type], published_at: row[:published_at],
                                           sentiment: row[:sentiment] %>
      <% end %>
    </div>
  </div>
</section>
