<% content_for :title, "Companies" %>
<section class="view" id="view-companies">
  <div class="view-head">
    <h1>Companies</h1>
    <p class="muted">Research and market data side by side. Pick a company to see its profile, charts and financials.</p>
  </div>
  <div class="company-layout">
    <%= render "companies/list", companies: @companies, active: nil %>
    <div class="company-detail" id="company-detail">
      <div class="panel">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Ticker</th><th scope="col">Company</th><th scope="col">Sector</th>
                <th scope="col" class="num">Share price</th><th scope="col">Price date</th>
                <th scope="col" class="num">Docs</th><th scope="col" class="num">Tone</th>
              </tr>
            </thead>
            <tbody>
              <% @companies.each do |company| %>
                <tr>
                  <td><%= link_to company[:ticker], company_path(company[:ticker]) %></td>
                  <td><%= company[:name] %></td>
                  <td><%= company[:sector].presence || "n/a" %></td>
                  <td class="num"><%= price(company[:share_price], company[:currency]) %></td>
                  <td><%= iso(company[:as_of]) %></td>
                  <td class="num"><%= num(company[:documents]) %></td>
                  <td class="num"><%= tone(company[:sentiment]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
